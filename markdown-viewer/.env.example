# Kopieer naar `.env` of `.env.local` (beide worden bij `npm run dev` ingeladen).

# --- Optie A: aparte docx-export container (LLM2DOCX profile docx-api, meestal :8790) ---
# DOCX_EXPORT_URL=http://127.0.0.1:8790
# DOCX_EXPORT_STYLE=minimal
# DOCX_EXPORT_TOKEN=...  alleen als DOCX_EXPORT_SERVICE_TOKEN op die service staat

# --- Optie B: LLM2DOCX-webportaal (zelfde stack als MCP op :8080) — géén MCP-protocol in de browser;
#    gebruik REST POST /api/documents/generate (zelfde motor als MCP-tool generate_document). ---
DOCX_EXPORT_URL=http://127.0.0.1:8080
DOCX_EXPORT_STYLE=portal
# Verplicht: API-sleutel uit het portaal (rol editor of admin), begint met llm2docx_
# DOCX_EXPORT_TOKEN=

# Optioneel — moet gelijk zijn aan de API waarnaar Vite proxied (default 8787):
# API_PORT=8787

# Verplicht wanneer auth aan staat (default). Voor Docker Desktop: gebruik bij voorkeur
# `.env.docker.local`, zie docs/DOCKER_DESKTOP.md.
# IOMS_AUTH_USER=joost
# IOMS_AUTH_PASSWORD=vervang-dit-door-een-sterk-wachtwoord
# Alleen voor lokale diagnose, niet aanbevolen op LAN/Docker:
# IOMS_AUTH_DISABLED=1

# Optioneel — browser roept o.a. Word-export rechtstreeks op deze API aan (zelfde poort als API_PORT),
# i.p.v. via de Vite `/api`-proxy. Agent-config/chat gebruikt in dev de proxy (zelfde origin als de UI).
# VITE_API_ORIGIN=http://127.0.0.1:8787

# Optioneel — max. agent-chatberichten per document (user+assistant paren; default 40)
# AGENT_CHAT_HISTORY_MAX_MESSAGES=40

# Optioneel — agent (LLM) als er géén agent.config / agent.config.json op de server staat (o.a. Docker-image).
# Bestanden hebben voorrang; deze variabelen vullen alleen lege velden aan.
# AGENT_API_KEY=
# AGENT_ENDPOINT=https://api.example.com/v1
# AGENT_MODEL=gpt-4o-mini
# (Aliassen: OPENAI_API_KEY, OPENAI_BASE_URL / OPENAI_API_BASE, OPENAI_MODEL)

# Optioneel — Tavily web search voor Ask-modus ("Internet zoeken (Tavily)").
# Maak een key aan in Tavily en zet hem server-side hier of in `.env.local`; herstart daarna de API.
# TAVILY_API_KEY=tvly-...
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=15000
# WEB_SEARCH_RESULT_MAX_CHARS=4000

# Optioneel — Confluence pagina's ophalen via server-side Personal Access Token (PAT).
# De PAT blijft op de server en wordt niet naar de browser of agentprompt gelekt.
# CONFLUENCE_BASE_URL=https://confluence.example.com
# CONFLUENCE_PAT=
# CONFLUENCE_TIMEOUT_MS=20000
# CONFLUENCE_PAGE_MAX_CHARS=60000

