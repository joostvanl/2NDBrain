# Kopieer naar `.env` of `.env.local` (beide worden bij `npm run dev` ingeladen).

# --- Optie A: aparte docx-export container (LLM2DOCX profile docx-api, meestal :8790) ---
# DOCX_EXPORT_URL=http://127.0.0.1:8790
# DOCX_EXPORT_STYLE=minimal
# DOCX_EXPORT_TOKEN=...  alleen als DOCX_EXPORT_SERVICE_TOKEN op die service staat

# --- Optie B: LLM2DOCX-webportaal (zelfde stack als MCP op :8080) — géén MCP-protocol in de browser;
#    gebruik REST POST /api/documents/generate (zelfde motor als MCP-tool generate_document). ---
DOCX_EXPORT_URL=http://127.0.0.1:8080
DOCX_EXPORT_STYLE=portal
# Verplicht: API-sleutel uit het portaal (rol editor of admin), begint met llm2docx_
# DOCX_EXPORT_TOKEN=

# Optioneel — moet gelijk zijn aan de API waarnaar Vite proxied (default 8787):
# API_PORT=8787

# Verplicht wanneer auth aan staat (default). Voor Docker Desktop: gebruik bij voorkeur
# `.env.docker.local`, zie docs/DOCKER_DESKTOP.md.
# IOMS_AUTH_USER=joost
# IOMS_AUTH_PASSWORD=vervang-dit-door-een-sterk-wachtwoord
# Alleen voor lokale diagnose, niet aanbevolen op LAN/Docker:
# IOMS_AUTH_DISABLED=1

# Optioneel — browser roept o.a. Word-export rechtstreeks op deze API aan (zelfde poort als API_PORT),
# i.p.v. via de Vite `/api`-proxy. Agent-config/chat gebruikt in dev de proxy (zelfde origin als de UI).
# VITE_API_ORIGIN=http://127.0.0.1:8787

# Optioneel — max. agent-chatberichten per document (user+assistant paren; default 40)
# AGENT_CHAT_HISTORY_MAX_MESSAGES=40

# Optioneel — LLM stabiliteit. Lokale timeout blijft bewust onder typische 240s gateway timeouts.
# LLM_REQUEST_TIMEOUT_MS=210000
# LLM_RETRY_MAX=2
# LLM_RETRY_BASE_MS=1200

# Optioneel — agent (LLM) als er géén agent.config / agent.config.json op de server staat (o.a. Docker-image).
# Bestanden hebben voorrang; deze variabelen vullen alleen lege velden aan.
# AGENT_API_KEY=
# AGENT_ENDPOINT=https://api.example.com/v1
# AGENT_MODEL=gpt-4o-mini
# (Aliassen: OPENAI_API_KEY, OPENAI_BASE_URL / OPENAI_API_BASE, OPENAI_MODEL)

# Optioneel — Nexus Auto model-router (model: auto in agent.config.json)
# MODEL_ROUTER_EXPLORATION_RATE=0.08
# MODEL_ROUTER_DATA_DIR=./data
# MODEL_CATALOG_OVERRIDES_PATH=./model-catalog.overrides.json

# Maak een key aan in Tavily en zet hem server-side hier of in `.env.local`; herstart daarna de API.
# TAVILY_API_KEY=tvly-...
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=15000
# WEB_SEARCH_RESULT_MAX_CHARS=4000

# Optioneel — Confluence pagina's ophalen via server-side Personal Access Token (PAT).
# De PAT blijft op de server en wordt niet naar de browser of agentprompt gelekt.
# CONFLUENCE_BASE_URL=https://confluence.hosted-tools.com
# CONFLUENCE_PAT=
# Optioneel — Basic auth i.p.v. Bearer (Confluence-gebruikersnaam of e-mail + PAT als wachtwoord):
# CONFLUENCE_USER=
# CONFLUENCE_TIMEOUT_MS=20000
# CONFLUENCE_PAGE_MAX_CHARS=60000
#
# Bij confluence.hosted-tools.com onderschept SSO REST-verkeer. PAT-only werkt daar niet.
# Nexus hergebruikt een Edge-sessie via CDP (page-target) en volgt SSO-redirects.
# In de UI: knop Browser-sessie (start desnoods Edge op poort 9224, daarna cookies syncen).
# CONFLUENCE_BROWSER_SESSION=auto
# CONFLUENCE_BROWSER_CDP_URL=http://127.0.0.1:9224
# Optioneel — bewaar gesynchroniseerde cookies tussen herstarts:
# CONFLUENCE_COOKIE_FILE=../Files/.secrets/confluence-cookie.txt

# Optioneel — Jira issues zoeken/lezen via server-side PAT (geen UI-knop).
# URL is configurabel; iO-voorbeeld:
# JIRA_BASE_URL=https://jira.hosted-tools.com
# JIRA_PAT=
# JIRA_TIMEOUT_MS=20000
# hosted-tools SSO onderschept REST vaak hetzelfde als Confluence: hergebruik de
# bestaande browser-sessie (debug-Edge / Confluence sync), geen aparte Jira-knop.
# Open Jira in dezelfde debug-Edge (poort 9224), niet in gewone Edge. Cookies
# worden per host gefilterd (Confluence-JSESSIONID mag Jira niet overschrijven).

# Optioneel — lokale Outlook Desktop tools voor de agent.
# Werkt alleen op Windows met Outlook Desktop en het lokale Outlook-profiel.
# Read-only: agenda zoeken, mail zoeken en één gevonden mail lezen.
# OUTLOOK_TOOLS_DISABLED=1
# Standaard koppelt iOMS alleen aan een al draaiende Outlook. Zet dit alleen op 1
# als iOMS Outlook Desktop automatisch mag starten.
# OUTLOOK_ALLOW_START=1
# Naam van de Outlook-agenda waar iOMS in mag schrijven. De hoofdagenda blijft read-only.
# OUTLOOK_MANAGED_CALENDAR_NAME=2ndbrain
# OUTLOOK_POWERSHELL=powershell.exe

# E-mailagent — mailbox-identiteit voor CC-filter (alleen CC = geen actie/Kanban)
# EMAIL_AGENT_MAILBOX=joost.vanleeuwaarden@iodigital.com
# EMAIL_AGENT_MAILBOX_NAMES=Joost van Leeuwaarden

# Optioneel — Nexus-orkestratie (evidence, cache, experiment-filter)
# NEXUS_EXPERIMENT_PATHS=90-experiments-en-test
# NEXUS_TOOL_CACHE=1
# NEXUS_STRUCTURED_EVIDENCE=1
# NEXUS_CRITICAL_THREADS_PATH=../Files/.memory/system/critical-threads.json

