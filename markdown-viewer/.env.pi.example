# Kopieer op de Raspberry Pi naar `.env.pi`:
#   cp .env.pi.example .env.pi
#
# Zet echte secrets alleen in `.env.pi`.

# GHCR image die door GitHub Actions wordt gepubliceerd.
# Vervang OWNER/REPO door de lowercase GitHub owner/repository.
IOMS_IMAGE=ghcr.io/OWNER/REPO/ioms-markdown-viewer:latest

# Poort op de Raspberry Pi. Open op je LAN:
#   http://<pi-ip>:8787
APP_PORT=8787

# Persistente data op de Raspberry Pi.
IOMS_FILES_DIR=/opt/ioms/files
IOMS_CONFIG_DIR=/opt/ioms/config

# Verplicht: Basic Auth voor viewer en API.
IOMS_AUTH_USER=joost
IOMS_AUTH_PASSWORD=vervang-dit-door-een-sterk-wachtwoord

# Agent/LLM configuratie.
AGENT_API_KEY=
AGENT_ENDPOINT=
AGENT_MODEL=

# Optioneel: OpenAI-compatible aliases.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optioneel: Tavily web search.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_RESULT_MAX_CHARS=4000

# Optioneel: Confluence integratie.
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
CONFLUENCE_TIMEOUT_MS=20000
CONFLUENCE_PAGE_MAX_CHARS=60000

# Optioneel: externe Word-export service.
# Gebruik op de Pi geen 127.0.0.1 tenzij die service ook op de Pi zelf draait.
DOCX_EXPORT_URL=
DOCX_EXPORT_STYLE=minimal
DOCX_EXPORT_TOKEN=
