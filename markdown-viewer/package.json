{
  "name": "markdown-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:unified": "node --watch server/index.mjs --dev",
    "build": "tsc && vite build",
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm run start",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:local:up": "docker compose --env-file .env.docker.local -f docker-compose.local.yml up -d --build",
    "docker:local:down": "docker compose --env-file .env.docker.local -f docker-compose.local.yml down",
    "docker:pi:config": "docker compose --env-file .env.pi.example -f docker-compose.pi.yml config",
    "docker:pi:pull": "docker compose --env-file .env.pi -f docker-compose.pi.yml pull",
    "docker:pi:up": "docker compose --env-file .env.pi -f docker-compose.pi.yml up -d"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^15.0.6",
    "mermaid": "^11.15.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.1"
  }
}
