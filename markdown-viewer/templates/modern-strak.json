{
  "version": 1,
  "displayName": "Modern strak — prettig lezend",
  "document": {
    "shellBackground": "#eaeaec",
    "pageBackground": "#fafafa",
    "pageMaxWidth": "728px",
    "pagePadding": "56px 56px",
    "pageMarginY": "24px",
    "pageRadius": "14px",
    "pageShadow": "0 4px 6px rgba(15, 23, 42, 0.04), 0 12px 32px rgba(15, 23, 42, 0.07)",
    "pageBorder": "1px solid rgba(15, 23, 42, 0.06)"
  },
  "cover": {
    "enabled": true,
    "background": "linear-gradient(145deg, #18181b 0%, #27272a 48%, #3f3f46 100%)",
    "color": "#fafafa",
    "minHeight": "72vh",
    "padding": "56px 48px",
    "showDocumentTitle": true,
    "subtitleText": "",
    "metaText": "",
    "title": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "2.5rem",
      "weight": "600",
      "lineHeight": "1.12",
      "letterSpacing": "-0.03em",
      "marginBottom": "12px"
    },
    "subtitle": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "0.8125rem",
      "weight": "600",
      "letterSpacing": "0.18em",
      "color": "rgba(250, 250, 250, 0.72)"
    },
    "meta": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "0.9375rem",
      "color": "rgba(250, 250, 250, 0.55)"
    }
  },
  "endPage": {
    "enabled": true,
    "background": "#f4f4f5",
    "color": "#3f3f46",
    "minHeight": "36vh",
    "padding": "44px 48px",
    "titleText": "Einde document",
    "bodyText": "",
    "title": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1.5rem",
      "weight": "600",
      "letterSpacing": "-0.02em",
      "marginBottom": "10px"
    },
    "body": {
      "family": "'Source Serif 4', Georgia, serif",
      "size": "1.0625rem",
      "lineHeight": "1.65",
      "color": "#52525b"
    }
  },
  "toc": {
    "enabled": true,
    "heading": "Inhoud",
    "headingStyle": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1.5rem",
      "weight": "600",
      "letterSpacing": "-0.02em",
      "marginBottom": "22px",
      "color": "#18181b"
    },
    "itemStyle": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "0.9375rem",
      "lineHeight": "1.5"
    },
    "containerPadding": "0 0 36px",
    "maxWidth": "100%",
    "borderBottom": "1px solid rgba(24, 24, 27, 0.08)",
    "linkColor": "#2563eb"
  },
  "prose": {
    "fontFamily": "'Source Serif 4', Georgia, 'Times New Roman', serif",
    "fontSize": "1.125rem",
    "lineHeight": "1.72",
    "color": "#292524",
    "maxWidth": "100%",
    "paragraphMargin": "0 0 1em"
  },
  "headings": {
    "h1": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1.875rem",
      "weight": "600",
      "letterSpacing": "-0.03em",
      "lineHeight": "1.2",
      "marginTop": "2.1rem",
      "marginBottom": "0.75rem",
      "color": "#18181b"
    },
    "h2": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1.375rem",
      "weight": "600",
      "letterSpacing": "-0.02em",
      "lineHeight": "1.25",
      "marginTop": "1.85rem",
      "marginBottom": "0.6rem",
      "color": "#27272a"
    },
    "h3": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1.125rem",
      "weight": "600",
      "marginTop": "1.5rem",
      "marginBottom": "0.45rem",
      "color": "#3f3f46"
    },
    "h4": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1.0625rem",
      "weight": "600",
      "marginTop": "1.25rem",
      "marginBottom": "0.35rem",
      "color": "#52525b"
    },
    "h5": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "1rem",
      "weight": "600",
      "marginTop": "1.1rem",
      "marginBottom": "0.28rem",
      "color": "#71717a"
    },
    "h6": {
      "family": "'DM Sans', system-ui, sans-serif",
      "size": "0.9375rem",
      "weight": "600",
      "marginTop": "1rem",
      "marginBottom": "0.24rem",
      "color": "#a1a1aa"
    }
  },
  "blockquote": {
    "marginTop": "1.1rem",
    "marginBottom": "1.1rem",
    "padding": "16px 22px",
    "borderLeft": "3px solid #0d9488",
    "background": "rgba(240, 253, 250, 0.85)",
    "color": "#44403c",
    "fontStyle": "normal"
  },
  "lists": {
    "ul": {
      "marginTop": "0.35em",
      "marginBottom": "1em",
      "paddingLeft": "1.25rem",
      "itemMargin": "0.3em 0",
      "markerColor": "#78716c",
      "nestedMarginTop": "0.3em"
    },
    "ol": {
      "marginTop": "0.35em",
      "marginBottom": "1em",
      "paddingLeft": "1.35rem",
      "itemMargin": "0.3em 0",
      "nestedMarginTop": "0.3em"
    }
  },
  "table": {
    "width": "100%",
    "borderCollapse": "collapse",
    "marginTop": "1.15rem",
    "marginBottom": "1.4rem",
    "borderColor": "rgba(24, 24, 27, 0.12)",
    "headerBackground": "#f4f4f5",
    "headerColor": "#18181b",
    "headerFontWeight": "600",
    "cellPadding": "11px 14px",
    "rowAlternateBackground": "rgba(250, 250, 250, 0.9)",
    "fontSize": "0.98rem"
  },
  "hr": {
    "border": "none",
    "borderTop": "1px solid rgba(24, 24, 27, 0.1)",
    "marginTop": "2rem",
    "marginBottom": "2rem"
  },
  "code": {
    "fontFamily": "ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace",
    "fontSize": "0.86em",
    "background": "#f4f4f5",
    "color": "#18181b",
    "padding": "2px 6px",
    "borderRadius": "5px",
    "blockPadding": "16px 18px",
    "blockBorder": "1px solid rgba(24, 24, 27, 0.08)"
  },
  "link": {
    "color": "#1d4ed8",
    "textDecoration": "underline",
    "textUnderlineOffset": "3px"
  },
  "strong": {
    "fontWeight": "650",
    "color": "#1c1917"
  },
  "em": {
    "fontStyle": "italic"
  },
  "print": {
    "h1PageBreakBefore": true,
    "h2PageBreakBefore": true
  },
  "screen": {
    "chapterDividerBeforeH1": false,
    "chapterDividerBeforeH2": false,
    "visualPageBreaks": true,
    "visualPageSplit": "h1",
    "visualPageMinHeight": "74vh"
  }
}
